{
  "name": "@squircle-icons/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "validate": "node --import tsx tools/validate.ts",
    "build": "tsc -p tsconfig.build.json && node --import tsx tools/build.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm validate && pnpm check && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "node -e \"throw new Error('Publication is disabled pending package naming and release review')\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/svg-path-parser": "^1.1.6",
    "fast-xml-parser": "5.11.2",
    "svg-path-parser": "1.1.0",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "prettier": "3.9.10"
  },
  "files": [
    "dist",
    "src",
    "icons",
    "README.md",
    "LICENSE",
    "DESIGN_RULES.md",
    "ICON_BATCHES.md",
    "MORPH.md",
    "ICON_RULES.md"
  ],
  "exports": {
    "./catalog.json": "./dist/catalog.json",
    "./catalog-types": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./source/types": "./src/types.ts",
    "./morph/sun-moon": {
      "types": "./dist/morphs/sun-moon.d.ts",
      "default": "./dist/morphs/sun-moon.js"
    },
    "./morph/sun-moon.json": "./dist/morphs/sun-moon.json",
    "./morph/plus-x": {
      "types": "./dist/morphs/plus-x.d.ts",
      "default": "./dist/morphs/plus-x.js"
    },
    "./morph/plus-x.json": "./dist/morphs/plus-x.json",
    "./morph/menu-x": {
      "types": "./dist/morphs/menu-x.d.ts",
      "default": "./dist/morphs/menu-x.js"
    },
    "./morph/menu-x.json": "./dist/morphs/menu-x.json",
    "./morph/round-strokes": {
      "types": "./dist/morphs/round-strokes.d.ts",
      "default": "./dist/morphs/round-strokes.js"
    },
    "./morph/plus-minus": {
      "types": "./dist/morphs/plus-minus.d.ts",
      "default": "./dist/morphs/plus-minus.js"
    },
    "./morph/plus-minus.json": "./dist/morphs/plus-minus.json"
  },
  "description": "Original Squircle SVG artwork, metadata and framework-independent types.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squircle-icons/core.git"
  },
  "homepage": "https://github.com/squircle-icons/core#readme",
  "bugs": {
    "url": "https://github.com/squircle-icons/core/issues"
  }
}
